{
  "name": "dsh-ark-quota",
  "description": "火山方舟订阅套餐剩余额度侧边栏小组件：宿主半区代理控制台 GetCodingPlanUsage，浏览器半区渲染 footer 固定小组件",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/signature.js && node --check lib/client.js && node --check tools/check.mjs",
    "test:host": "node tools/smoke-host.mjs",
    "test:client": "node tools/smoke-client.mjs"
  },
  "files": [
    "lib",
    "tools",
    "cordis.patch.yml.example",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.5.4"
  },
  "license": "MIT"
}
